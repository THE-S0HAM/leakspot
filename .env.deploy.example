# Copy to .env.deploy (git-ignored) and edit by hand. Never commit .env.deploy.
# The CDK stack reads only LEAKSPOT_COMMAND_CODE at synth and stores just its SHA-256 in the Lambda
# environment; the plain code never leaves your machine except through the submission form.

# 8 characters from ABCDEFGHJKMNPQRSTVWXYZ23456789 (no I, L, O, U). Case-insensitive when typed.
# Generate a fresh one:
# node -e "const a='ABCDEFGHJKMNPQRSTVWXYZ23456789';console.log(Array.from(require('crypto').randomBytes(8),b=>a[b%a.length]).join(''))"
LEAKSPOT_COMMAND_CODE=change-me
