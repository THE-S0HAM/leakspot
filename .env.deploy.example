# Copy to .env.deploy (git-ignored, agent-ignored) with: node scripts/init-secrets.mjs
# Then edit the values below by hand. Never commit .env.deploy.

# 8 characters, letters and digits. Share it with judges only through the submission form.
# Generate a fresh one, e.g.: node -e "console.log(require('crypto').randomBytes(6).toString('base64url').slice(0,8))"
LEAKSPOT_COMMAND_CODE=change-me

# At least 32 random bytes, base64url. init-secrets.mjs fills this in for you.
LEAKSPOT_SESSION_SECRET=generated-by-init-secrets

# Where CloudWatch alarm emails go (SNS email subscription; confirm it once).
LEAKSPOT_ALERT_EMAIL=you@example.com
